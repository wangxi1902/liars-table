# ---------- LLM (DeepSeek, OpenAI-compatible) ----------
# 注意：这个文件会提交到 Git，只能写占位符。
# 真实 key 请写进 .env（已被 .gitignore 忽略，不会进仓库）。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 思考模式：默认关闭。
# 开启后思维链会吃掉 max_tokens，导致 JSON 被截断、agent 出现"沉默"；
# 而且思考模式下 temperature 不生效，9 个 agent 的输出会高度雷同。
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=800

# ---------- Agent decision budget ----------
# 以下都是“上限”，不是要求 AI 必须思考这么久。
DECISION_TIMEOUT_SECONDS=5.0
DECISION_MAX_STEPS=8
DECISION_MAX_MODEL_CALLS=2
DECISION_MAX_COMPLETION_TOKENS=800
DECISION_MAX_RETRIES=1

# ---------- Embeddings ----------
# dashscope | ollama | fake
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-v3

# ---------- Runtime ----------
LOG_LEVEL=INFO
DATABASE_URL=sqlite+pysqlite:///./data/liars.db
